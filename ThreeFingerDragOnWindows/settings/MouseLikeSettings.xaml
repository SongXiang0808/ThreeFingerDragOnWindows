<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="ThreeFingerDragOnWindows.settings.MouseLikeSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ThreeFingerDragOnWindows.settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Spacing="16" Margin="16">
            <!-- Header -->
            <TextBlock Text="MouseLike 触摸板模式"
                      Style="{ThemeResource TitleTextBlockStyle}" />

            <TextBlock Text="将触摸板转换为类鼠标操作模式，支持多指手势控制"
                      Style="{ThemeResource BodyTextBlockStyle}"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      TextWrapping="Wrap" />

            <!-- Enable/Disable Toggle -->
            <ToggleSwitch x:Name="EnableMouseLikeToggle"
                         Header="启用 MouseLike 模式"
                         OnContent="开启"
                         OffContent="关闭"
                         Toggled="EnableMouseLikeToggle_Toggled" />

            <!-- Settings Panel -->
            <StackPanel x:Name="SettingsPanel" Spacing="12">

                <!-- Mouse Sensitivity -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="鼠标敏感度"
                              Style="{ThemeResource BodyStrongTextBlockStyle}"
                              Grid.Row="0"/>

                    <StackPanel Orientation="Horizontal" Spacing="8" Grid.Row="1">
                        <TextBlock Text="慢" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Slider x:Name="SensitivitySlider"
                               Width="200"
                               Minimum="0.1"
                               Maximum="3.0"
                               Value="1.0"
                               StepFrequency="0.1"
                               ValueChanged="SensitivitySlider_ValueChanged"/>
                        <TextBlock Text="快" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="SensitivityValueText"
                                  Text="1.0"
                                  MinWidth="30"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- Thumb Scale -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="手指尺寸缩放"
                              Style="{ThemeResource BodyStrongTextBlockStyle}"
                              Grid.Row="0"/>

                    <StackPanel Orientation="Horizontal" Spacing="8" Grid.Row="1">
                        <TextBlock Text="小" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Slider x:Name="ThumbScaleSlider"
                               Width="200"
                               Minimum="0.5"
                               Maximum="2.0"
                               Value="1.0"
                               StepFrequency="0.1"
                               ValueChanged="ThumbScaleSlider_ValueChanged"/>
                        <TextBlock Text="大" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="ThumbScaleValueText"
                                  Text="1.0"
                                  MinWidth="30"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- Jitter Threshold -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="抖动消除阈值"
                              Style="{ThemeResource BodyStrongTextBlockStyle}"
                              Grid.Row="0"/>

                    <StackPanel Orientation="Horizontal" Spacing="8" Grid.Row="1">
                        <TextBlock Text="低" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Slider x:Name="JitterThresholdSlider"
                               Width="200"
                               Minimum="5"
                               Maximum="20"
                               Value="10"
                               StepFrequency="1"
                               ValueChanged="JitterThresholdSlider_ValueChanged"/>
                        <TextBlock Text="高" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="JitterThresholdValueText"
                                  Text="10"
                                  MinWidth="30"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- Status Display -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                       BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                       BorderThickness="1"
                       CornerRadius="4"
                       Padding="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="状态信息"
                                  Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                        <TextBlock x:Name="StatusText"
                                  Text="MouseLike 模式已禁用"
                                  Style="{ThemeResource CaptionTextBlockStyle}"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="ResetSettingsButton"
                           Content="重置为默认设置"
                           Click="ResetSettingsButton_Click"/>
                    <Button x:Name="ShowLogFileButton"
                           Content="查看调试日志"
                           Click="ShowLogFileButton_Click"/>
                </StackPanel>

            </StackPanel>

            <!-- Help Text -->
            <Border Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                   BorderBrush="{ThemeResource SystemFillColorAttentionBrush}"
                   BorderThickness="1"
                   CornerRadius="4"
                   Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="使用说明"
                              Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    <TextBlock TextWrapping="Wrap"
                              Style="{ThemeResource CaptionTextBlockStyle}">
                        • 单指：移动鼠标指针<LineBreak/>
                        • 双指（左侧）：左键功能<LineBreak/>
                        • 双指（右侧）：右键功能<LineBreak/>
                        • 双指（合拢）：中键功能<LineBreak/>
                        • 启用此模式后，三指拖拽功能将被禁用
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>